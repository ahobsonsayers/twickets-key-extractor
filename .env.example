# Copy to .env and fill in. See README "Getting a gplaydl API key".
# GPLAYDL_API_KEY is the FULL gplaydl config JSON, exactly as `gplaydl link`
# writes ~/.config/gplaydl/config.json, e.g.:
# GPLAYDL_API_KEY='{"dispenser":"https://dispenser.gplaydl.com","api_key":"your-key-here"}'
GPLAYDL_API_KEY=
